+void MainWindow::resized(std::size_t width, std::size_t height)
+{
+	// Fixed-size controls and their margins do not fit below the default size.
+	// Clamp the native size before Window::resized dispatches layout callbacks.
+	auto size = getNativeSize();
+	if(size.width < main_width || size.height < main_height)
+	{
+		resize(std::max(size.width, main_width),
+		       std::max(size.height, main_height));
+		return; // Lay out after the native resize has completed.
+	}
+	dggui::Window::resized(width, height);
+}
